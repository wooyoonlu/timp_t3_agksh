 <Worksheet ss:Name="Тест-план">
  <Table ss:ExpandedColumnCount="8" ss:ExpandedRowCount="19" x:FullColumns="1"
   x:FullRows="1" ss:DefaultRowHeight="15">
   <Column ss:Width="35.25"/>
   <Column ss:Width="180"/>
   <Column ss:Width="65.25"/>
