    <Cell ss:StyleID="s80"><Data ss:Type="Number">3</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Генерация HTML и проверка index.html</Data></Cell>
    <Cell ss:StyleID="s80"><Data ss:Type="Number">0.5</Data></Cell>
