  <Table ss:ExpandedColumnCount="8" ss:ExpandedRowCount="21" x:FullColumns="1"
   x:FullRows="1" ss:DefaultRowHeight="15">
   <Column ss:Width="65.25"/>
   <Column ss:Width="90"/>
   <Column ss:Width="219.75"/>
