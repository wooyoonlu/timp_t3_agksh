   <Column ss:Width="219.75"/>
   <Column ss:Width="249.75"/>
   <Column ss:Width="65.25" ss:Span="1"/>
   <Row ss:AutoFitHeight="0" ss:Height="24">
    <Cell ss:MergeAcross="7" ss:StyleID="s63"><Data ss:Type="String">Чек-лист системного тестирования и найденные дефекты</Data></Cell>
   </Row>
   <Row ss:Index="3" ss:AutoFitHeight="0">
    <Cell ss:StyleID="s79"><Data ss:Type="String">ID</Data></Cell>
    <Cell ss:StyleID="s79"><Data ss:Type="String">Область</Data></Cell>
    <Cell ss:StyleID="s79"><Data ss:Type="String">Проверка</Data></Cell>
    <Cell ss:StyleID="s79"><Data ss:Type="String">Запрос / данные</Data></Cell>
    <Cell ss:StyleID="s79"><Data ss:Type="String">Ожидаемый результат</Data></Cell>
    <Cell ss:StyleID="s79"><Data ss:Type="String">Фактический результат</Data></Cell>
    <Cell ss:StyleID="s79"><Data ss:Type="String">Статус</Data></Cell>
    <Cell ss:StyleID="s79"><Data ss:Type="String">№ дефекта</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s80"><Data ss:Type="String">CH-001</Data></Cell>
