 <Worksheet ss:Name="Дефекты">
  <Table ss:ExpandedColumnCount="10" ss:ExpandedRowCount="5" x:FullColumns="1"
   x:FullRows="1" ss:DefaultRowHeight="15">
   <Column ss:Width="60"/>
   <Column ss:Width="240"/>
   <Column ss:Width="69.75" ss:Span="1"/>
   <Column ss:Index="5" ss:Width="75"/>
   <Column ss:Width="90"/>
   <Column ss:Width="300"/>
   <Column ss:Width="260.25"/>
   <Column ss:Width="279.75"/>
   <Column ss:Width="300"/>
   <Row ss:AutoFitHeight="0" ss:Height="24">
    <Cell ss:MergeAcross="9" ss:StyleID="s63"><Data ss:Type="String">Зарегистрированные дефекты TCP-сервера</Data></Cell>
   </Row>
   <Row ss:Index="3" ss:AutoFitHeight="0">
    <Cell ss:StyleID="s79"><Data ss:Type="String">№</Data></Cell>
    <Cell ss:StyleID="s79"><Data ss:Type="String">Название</Data></Cell>
    <Cell ss:StyleID="s79"><Data ss:Type="String">Важность</Data></Cell>
    <Cell ss:StyleID="s79"><Data ss:Type="String">Приоритет</Data></Cell>
    <Cell ss:StyleID="s79"><Data ss:Type="String">Статус</Data></Cell>
    <Cell ss:StyleID="s79"><Data ss:Type="String">Компонент</Data></Cell>
    <Cell ss:StyleID="s79"><Data ss:Type="String">Шаги воспроизведения</Data></Cell>
    <Cell ss:StyleID="s79"><Data ss:Type="String">Ожидаемый результат</Data></Cell>
    <Cell ss:StyleID="s79"><Data ss:Type="String">Фактический результат</Data></Cell>
    <Cell ss:StyleID="s79"><Data ss:Type="String">Рекомендация</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="99.9375">
    <Cell ss:StyleID="s81"><Data ss:Type="String">D-001</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Преждевременная обработка фрагментированного TCP-запроса</Data></Cell>
    <Cell ss:StyleID="s81"><Data ss:Type="String">Major</Data></Cell>
    <Cell ss:StyleID="s81"><Data ss:Type="String">High</Data></Cell>
    <Cell ss:StyleID="s90"><Data ss:Type="String">Opened</Data></Cell>
    <Cell ss:StyleID="s91"><Data ss:Type="String">TCP-парсер</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">1. Подключиться к серверу.&#10;2. Отправить первую часть: hash|hel.&#10;3. Подождать более 30 мс.&#10;4. Отправить вторую часть: lo\n.</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Сервер должен дождаться перевода строки и обработать единый запрос hash|hello.</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Таймер может обработать первую часть как отдельный запрос до поступления продолжения.</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Обрабатывать запрос только после \n либо использовать длину сообщения в протоколе.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="99.9375">
    <Cell ss:StyleID="s89"><Data ss:Type="String">D-002</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Сервер продолжает работу при недоступной SQLite-БД</Data></Cell>
    <Cell ss:StyleID="s89"><Data ss:Type="String">Major</Data></Cell>
    <Cell ss:StyleID="s89"><Data ss:Type="String">Medium</Data></Cell>
    <Cell ss:StyleID="s90"><Data ss:Type="String">Opened</Data></Cell>
    <Cell ss:StyleID="s91"><Data ss:Type="String">SQLite</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">1. Запретить запись в server_database.db.&#10;2. Запустить сервер.&#10;3. Подключиться к порту 33333.&#10;4. Отправить show_db.</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Сервер должен прекратить запуск или явно перейти в аварийный режим.</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">TCP-сервер продолжает слушать порт, но журнал не сохраняется.</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Проверять результат Database::open() и не запускать прослушивание порта при ошибке.</Data></Cell>
   </Row>
  </Table>
  <WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel">
   <Unsynced/>
   <Zoom>85</Zoom>
   <Panes>
    <Pane>
     <Number>3</Number>
     <ActiveRow>4</ActiveRow>
     <ActiveCol>5</ActiveCol>
    </Pane>
   </Panes>
   <ProtectObjects>False</ProtectObjects>
   <ProtectScenarios>False</ProtectScenarios>
  </WorksheetOptions>
 </Worksheet>
