   <Column ss:Width="54.75"/>
   <Column ss:Width="219.75"/>
   <Column ss:Width="150"/>
   <Column ss:Width="75"/>
   <Row ss:AutoFitHeight="0" ss:Height="24">
    <Cell ss:MergeAcross="7" ss:StyleID="s63"><Data ss:Type="String">Тест-план по системному тестированию TCP-сервера по теме №3</Data></Cell>
   </Row>
   <Row ss:Index="3" ss:AutoFitHeight="0">
    <Cell ss:MergeAcross="7" ss:StyleID="m1966322193764"><Data ss:Type="String">Цели тестирования</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="32.0625">
    <Cell ss:MergeAcross="7" ss:StyleID="m1966322193784"><Data ss:Type="String">Проверить обработку TCP-запросов, работу SQLite через Singleton, функции варианта 3 и генерацию документации Doxygen.</Data></Cell>
   </Row>
   <Row ss:Index="6" ss:AutoFitHeight="0">
    <Cell ss:MergeAcross="7" ss:StyleID="m1966322193804"><Data ss:Type="String">Критерий завершения</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="32.0625">
    <Cell ss:MergeAcross="7" ss:StyleID="m1966322193824"><Data ss:Type="String">Все обязательные функции проверены. Все дефекты задокументированы. Перед сдачей должны быть исправлены дефекты уровня Critical.</Data></Cell>
   </Row>
   <Row ss:Index="9" ss:AutoFitHeight="0">
    <Cell ss:MergeAcross="7"><Data ss:Type="String">Приоритет 1 — самый высокий</Data></Cell>
   </Row>
   <Row ss:Index="11" ss:AutoFitHeight="0">
    <Cell ss:StyleID="s79"><Data ss:Type="String">№</Data></Cell>
    <Cell ss:StyleID="s79"><Data ss:Type="String">Область функционала</Data></Cell>
    <Cell ss:StyleID="s79"><Data ss:Type="String">Приоритет</Data></Cell>
    <Cell ss:StyleID="s79"><Data ss:Type="String">Стратегия тестирования</Data></Cell>
    <Cell ss:StyleID="s79"><Data ss:Type="String">Часы</Data></Cell>
    <Cell ss:StyleID="s79"><Data ss:Type="String">Риски</Data></Cell>
    <Cell ss:StyleID="s79"><Data ss:Type="String">Статус</Data></Cell>
    <Cell ss:StyleID="s79"><Data ss:Type="String">Примечание</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="35.0625">
    <Cell ss:StyleID="s80"><Data ss:Type="Number">1</Data></Cell>
    <Cell ss:StyleID="s80"><Data ss:Type="String">TCP-подключение и парсер</Data></Cell>
    <Cell ss:StyleID="s80"><Data ss:Type="Number">1</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Позитивные и негативные запросы, несколько команд, фрагментация TCP</Data></Cell>
    <Cell ss:StyleID="s80"><Data ss:Type="Number">1</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Преждевременная обработка части сообщения</Data></Cell>
    <Cell ss:StyleID="s81"><Data ss:Type="String">Есть дефект</Data></Cell>
    <Cell ss:StyleID="s80"><Data ss:Type="String">D-001</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="35.0625">
    <Cell ss:StyleID="s80"><Data ss:Type="Number">2</Data></Cell>
    <Cell ss:StyleID="s80"><Data ss:Type="String">SQLite и Singleton</Data></Cell>
    <Cell ss:StyleID="s80"><Data ss:Type="Number">1</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Создание файла БД, запись запросов, ошибка открытия БД</Data></Cell>
    <Cell ss:StyleID="s80"><Data ss:Type="Number">1</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Сервер продолжает работу без доступной БД</Data></Cell>
    <Cell ss:StyleID="s81"><Data ss:Type="String">Есть дефект</Data></Cell>
    <Cell ss:StyleID="s80"><Data ss:Type="String">D-002</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s80"><Data ss:Type="Number">3</Data></Cell>
    <Cell ss:StyleID="s80"><Data ss:Type="String">Шифр Виженера</Data></Cell>
    <Cell ss:StyleID="s80"><Data ss:Type="Number">2</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Шифрование, расшифровка, проверка ключа</Data></Cell>
    <Cell ss:StyleID="s80"><Data ss:Type="Number">0.5</Data></Cell>
    <Cell ss:StyleID="s80"><Data ss:Type="String">Некорректный ключ</Data></Cell>
    <Cell ss:StyleID="s82"><Data ss:Type="String">Протестировано</Data></Cell>
    <Cell ss:StyleID="s80"/>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s80"><Data ss:Type="Number">4</Data></Cell>
    <Cell ss:StyleID="s80"><Data ss:Type="String">SHA-512</Data></Cell>
    <Cell ss:StyleID="s80"><Data ss:Type="Number">2</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Сравнение результата с известным SHA-512</Data></Cell>
    <Cell ss:StyleID="s80"><Data ss:Type="Number">0.5</Data></Cell>
    <Cell ss:StyleID="s80"><Data ss:Type="String">Кодирование строки</Data></Cell>
    <Cell ss:StyleID="s82"><Data ss:Type="String">Протестировано</Data></Cell>
    <Cell ss:StyleID="s80"/>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s80"><Data ss:Type="Number">5</Data></Cell>
    <Cell ss:StyleID="s80"><Data ss:Type="String">Метод деления пополам</Data></Cell>
    <Cell ss:StyleID="s80"><Data ss:Type="Number">2</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Корректный и некорректный интервалы</Data></Cell>
    <Cell ss:StyleID="s80"><Data ss:Type="Number">0.5</Data></Cell>
    <Cell ss:StyleID="s80"><Data ss:Type="String">Интервал без корня</Data></Cell>
    <Cell ss:StyleID="s82"><Data ss:Type="String">Протестировано</Data></Cell>
    <Cell ss:StyleID="s80"/>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="30">
    <Cell ss:StyleID="s80"><Data ss:Type="Number">6</Data></Cell>
    <Cell ss:StyleID="s80"><Data ss:Type="String">Кратчайший путь в графе</Data></Cell>
    <Cell ss:StyleID="s80"><Data ss:Type="Number">1</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Достижимый и недостижимый путь, проверка веса рёбер</Data></Cell>
    <Cell ss:StyleID="s80"><Data ss:Type="Number">1</Data></Cell>
    <Cell ss:StyleID="s80"><Data ss:Type="String">Ошибки маршрута</Data></Cell>
    <Cell ss:StyleID="s82"><Data ss:Type="String">Протестировано</Data></Cell>
    <Cell ss:StyleID="s80"/>
   </Row>
