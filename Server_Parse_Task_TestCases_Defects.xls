    <Cell ss:StyleID="s82"><Data ss:Type="String">PASS</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Путь корректный</Data></Cell>
    <Cell ss:StyleID="s80"/>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s80"><Data ss:Type="Number">2</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Отправить hash|hello</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Получен ответ SHA-512</Data></Cell>
    <Cell ss:StyleID="s82"><Data ss:Type="String">PASS</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Ответ получен</Data></Cell>
    <Cell ss:StyleID="s80"/>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s80"><Data ss:Type="Number">3</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Отправить show_db</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">В журнале есть запрос hash|hello</Data></Cell>
    <Cell ss:StyleID="s82"><Data ss:Type="String">PASS</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Запись найдена</Data></Cell>
    <Cell ss:StyleID="s80"/>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s80"><Data ss:Type="Number">4</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Проверить наличие server_database.db</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Физический файл существует</Data></Cell>
    <Cell ss:StyleID="s82"><Data ss:Type="String">PASS</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Файл создан</Data></Cell>
    <Cell ss:StyleID="s80"/>
   </Row>
  </Table>
